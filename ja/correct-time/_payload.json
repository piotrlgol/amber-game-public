[{"data":1,"prerenderedAt":97},["ShallowReactive",2],{"content-query-lNjQQjqlxO":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"body":10,"_type":91,"_id":92,"_source":93,"_file":94,"_stem":95,"_extension":96},"/ja/correct-time","ja",false,"","Correct Time","バルト海の琥珀の特徴的な魅力の一つは、その香りです。まるで松の樹脂のような香りが漂ってきます。琥珀は有機成分を含んでいるため、燃える際には明るく、すすを伴った炎を生み出し、松の樹脂の香りと共に黒い煙を立てます。",{"type":11,"children":12,"toc":88},"root",[13,20,39,44,56,61,73,78,83],{"type":14,"tag":15,"props":16,"children":17},"element","p",{},[18],{"type":19,"value":9},"text",{"type":14,"tag":15,"props":21,"children":22},{},[23,29],{"type":14,"tag":24,"props":25,"children":28},"img",{"alt":26,"src":27},"image alt text","/img/timeline/18.jpg",[],{"type":14,"tag":30,"props":31,"children":36},"span",{"className":32},[33,34,35],"text-subtitle2","text-caption","self-center",[37],{"type":19,"value":38},"Photo: Ivo Rappsilber",{"type":14,"tag":15,"props":40,"children":41},{},[42],{"type":19,"value":43},"琥珀は非常に軽量で、その比重は0.950から1.096の間で変動します。淡水では沈みますが、塩水では表面に浮かびでます。",{"type":14,"tag":15,"props":45,"children":46},{},[47,51],{"type":14,"tag":24,"props":48,"children":50},{"alt":26,"src":49},"/img/timeline/16.jpg",[],{"type":14,"tag":30,"props":52,"children":54},{"className":53},[33,34,35],[55],{"type":19,"value":38},{"type":14,"tag":15,"props":57,"children":58},{},[59],{"type":19,"value":60},"琥珀の化学構造は均一ではなく、微細分子（溶解性）と大分子（不溶解性）の二つの相から成り立っています。琥珀は絶え間ない変容を繰り返し、また、治療効果があるとされる成分である琥珀酸を含んでいます。この成分は、健康に良いとされ、しばしば治療や癒しの力と関連づけられています。\n古代に発見された琥珀の独特な静電気的特性は、布で擦ることによって小さな埃を引き寄せる力を持っています。この静電気の初期の現象は、静電気学の研究へとつながる礎を築きました。",{"type":14,"tag":15,"props":62,"children":63},{},[64,68],{"type":14,"tag":24,"props":65,"children":67},{"alt":26,"src":66},"/img/timeline/17.jpg",[],{"type":14,"tag":30,"props":69,"children":71},{"className":70},[33,34,35],[72],{"type":19,"value":38},{"type":14,"tag":15,"props":74,"children":75},{},[76],{"type":19,"value":77},"これまでに発見された中で最も大きなバルト海の琥珀の塊は、重さ約10kgに達し、その長さは47cmにも及びます。",{"type":14,"tag":15,"props":79,"children":80},{},[81],{"type":19,"value":82},"バルト海の琥珀は、石器時代から人々に愛され、使用されてきたため、最も古い素材の一つとして人類の歴史に名を刻んでいます。その色の幅は広く、ジュエリーデザイナーにとって素晴らしい特性を持っています。",{"type":14,"tag":15,"props":84,"children":85},{},[86],{"type":19,"value":87},"世界各地には、バルト海の琥珀の美しさとその悠久の歴史に焦点を当てた数多くの展示会、博物館、そして出版物が存在しています。",{"title":7,"searchDepth":89,"depth":89,"links":90},2,[],"markdown","content:ja:correct-time.md","content","ja/correct-time.md","ja/correct-time","md",1739449681405]