[{"data":1,"prerenderedAt":79},["ShallowReactive",2],{"content-query-ob5xxd7ylF":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"body":10,"_type":73,"_id":74,"_source":75,"_file":76,"_stem":77,"_extension":78},"/ja/about-amber","ja",false,"","About Amber","バルト海の琥珀は、深遠な謎を秘めた宝石です。自然の力によって形作られたこの化石化した樹脂は、ポジティブなエネルギーを引き寄せるだけでなく、幸運をもたらすお守りとして使われたり、海辺の思い出を蘇らせるのにも活用されています。『バルトの黄金』や『生ける石』と称され、その時を超えた美しさで、世代を超えて人々を魅了し続けています。",{"type":11,"children":12,"toc":70},"root",[13,20,29,34,41,46,53,58,65],{"type":14,"tag":15,"props":16,"children":17},"element","p",{},[18],{"type":19,"value":9},"text",{"type":14,"tag":15,"props":21,"children":22},{},[23],{"type":14,"tag":24,"props":25,"children":28},"img",{"alt":26,"src":27},"image alt text","/img/brylki/info/bursztyn.jpg",[],{"type":14,"tag":15,"props":30,"children":31},{},[32],{"type":19,"value":33},"人々がそれぞれ異なる肌の色を持つように、琥珀にも多彩な色合いがあり、まったく同じものは存在しません。その色は、樹脂の変化や、何百万年もの歳月を経て地中で育まれた環境によって決まります。バルト海の琥珀は、表面が内部よりもやや暗い色合いが特徴です。内部の色を覗き込んでみてはいかがでしょうか。",{"type":14,"tag":15,"props":35,"children":36},{},[37],{"type":14,"tag":24,"props":38,"children":40},{"alt":26,"src":39},"/img/brylki/info/13.jpg",[],{"type":14,"tag":15,"props":42,"children":43},{},[44],{"type":19,"value":45},"人々はバルト海の琥珀に100種類以上もの色のバリエーションを名付け、記述してきました。その中で最も一般的なのは、太陽を象徴する黄色です。",{"type":14,"tag":15,"props":47,"children":48},{},[49],{"type":14,"tag":24,"props":50,"children":52},{"alt":26,"src":51},"/img/brylki/info/bursztyny.jpg",[],{"type":14,"tag":15,"props":54,"children":55},{},[56],{"type":19,"value":57},"琥珀はしばしば多色の模様を持ち、その色調は時間とともに深みを増し、より気品ある、強く、豊かな色合いに変化していきます。",{"type":14,"tag":15,"props":59,"children":60},{},[61],{"type":14,"tag":24,"props":62,"children":64},{"alt":26,"src":63},"/img/brylki/info/brylki.jpg",[],{"type":14,"tag":15,"props":66,"children":67},{},[68],{"type":19,"value":69},"琥珀は、透明、半透明、または不透明と三種類あります。白い琥珀は、硬化の過程で閉じ込められた微細なガスの気泡によってその色を得ます。気泡が多いほど、より明るく、透明度が低くなります。",{"title":7,"searchDepth":71,"depth":71,"links":72},2,[],"markdown","content:ja:about-amber.md","content","ja/about-amber.md","ja/about-amber","md",1739449681404]