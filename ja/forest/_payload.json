[{"data":1,"prerenderedAt":43},["ShallowReactive",2],{"content-query-z2JRf4iaFG":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"body":10,"_type":37,"_id":38,"_source":39,"_file":40,"_stem":41,"_extension":42},"/ja/forest","ja",false,"","Forest","先史時代、現代の哺乳類、鳥類、昆虫の祖先が広大な森林に生息していた時代、気候は温暖で湿潤でした。\nこれらの森林は、およそ4,000万年前に出現したと考えられています。",{"type":11,"children":12,"toc":34},"root",[13,20,29],{"type":14,"tag":15,"props":16,"children":17},"element","p",{},[18],{"type":19,"value":9},"text",{"type":14,"tag":15,"props":21,"children":22},{},[23],{"type":14,"tag":24,"props":25,"children":28},"img",{"alt":26,"src":27},"image alt text","/img/forest/9.jpg",[],{"type":14,"tag":15,"props":30,"children":31},{},[32],{"type":19,"value":33},"時折、巨大な木々から粘り気のある樹脂が流れ出しました。その時こそ、バルト海の琥珀が生まれ始めたのです。それから数百万年が経ちました。\n琥珀の森の木々は非常に大きく、現在の森で見るものとは比べものにならないほどの大きさでした。",{"title":7,"searchDepth":35,"depth":35,"links":36},2,[],"markdown","content:ja:forest.md","content","ja/forest.md","ja/forest","md",1739449681406]